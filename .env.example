# Variables d'environnement à configurer dans Netlify
# (Site settings > Environment variables) — ne jamais committer les vraies valeurs.

# Clé secrète Stripe (Dashboard Stripe > Developers > API keys)
STRIPE_SECRET_KEY=sk_test_...

# Clé de signature du webhook Stripe (Dashboard Stripe > Developers > Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_...

# URL du projet Supabase (Project Settings > API > Project URL)
SUPABASE_URL=https://xxxxx.supabase.co

# Clé service_role Supabase (Project Settings > API) — jamais exposée au navigateur,
# utilisée uniquement par la fonction serveur stripe-webhook.js
SUPABASE_SERVICE_ROLE_KEY=eyJ...
